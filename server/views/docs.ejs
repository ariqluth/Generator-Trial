<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>API Docs — Postman Style</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/favicon.ico" />
    <style>
      html, body { height: 100%; }
      .method-badge { font-weight: 600; font-size: 11px; padding: 2px 6px; border-radius: 4px; }
      .GET    { background:#e0f2fe; color:#075985; }
      .POST   { background:#dcfce7; color:#166534; }
      .PUT    { background:#fef9c3; color:#854d0e; }
      .DELETE { background:#fee2e2; color:#991b1b; }
      .BULK   { background:#ede9fe; color:#5b21b6; }
      .sidebar { width: 300px; }
      .code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
      .shadow-inset { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.02); }
    </style>
  </head>
  <body class="bg-slate-900 text-slate-100">
    <div class="h-full flex">
      <!-- Sidebar -->
      <aside class="sidebar h-full bg-slate-950/40 border-r border-slate-800 flex flex-col">
        <div class="p-3 border-b border-slate-800">
          <div class="text-xs text-slate-300">Bearer Token</div>
          <div class="mt-1 flex gap-2">
            <input id="tokenInput" type="text" placeholder="JWT token" class="flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1 text-xs code"/>
            <button id="saveToken" class="text-xs bg-slate-700 hover:bg-slate-600 rounded px-2">Save</button>
          </div>
          <div class="text-xs text-slate-300 mt-3">Base URL</div>
          <div class="mt-1 flex gap-2">
            <input id="baseUrlInput" type="text" placeholder="http://localhost:3000" class="flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1 text-xs code"/>
            <button id="saveBaseUrl" class="text-xs bg-slate-700 hover:bg-slate-600 rounded px-2">Save</button>
          </div>
        </div>
        <div class="p-2 border-b border-slate-800">
          <input id="searchInput" type="text" placeholder="Search resources" class="w-full bg-slate-800 border border-slate-700 rounded px-2 py-1 text-xs"/>
        </div>
        <div id="navList" class="flex-1 overflow-y-auto"></div>
      </aside>

      <!-- Main -->
      <main class="flex-1 h-full flex flex-col">
        <!-- Header -->
        <div class="px-4 py-3 border-b border-slate-800 bg-slate-950/30 flex items-center gap-2 shadow-inset">
          <span id="methodBadge" class="method-badge GET">GET</span>
          <input id="pathInput" type="text" class="flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1 text-sm code" />
          <button id="copyBtn" class="text-xs bg-slate-700 hover:bg-slate-600 rounded px-3 py-1">Copy</button>
          <button id="resetBtn" class="text-xs bg-slate-700 hover:bg-slate-600 rounded px-3 py-1">Reset</button>
          <button id="sendBtn" class="text-xs bg-blue-600 hover:bg-blue-500 rounded px-3 py-1">Send</button>
        </div>

        <!-- Body -->
        <div class="flex-1 grid grid-cols-2 gap-0 overflow-hidden">
          <!-- Request builder -->
          <section class="h-full overflow-auto border-r border-slate-800">
            <div class="px-4 py-3">
              <div class="text-xs text-slate-300 mb-2">Params</div>
              <div id="paramsList" class="space-y-2"></div>
              <button id="addParam" class="mt-2 text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded px-2 py-1">+ Add Parameter</button>
            </div>
            <div class="px-4 py-3 border-t border-slate-800">
              <div class="flex items-center justify-between">
                <div class="text-xs text-slate-300">Body</div>
                <div class="space-x-2">
                  <button id="genExample" class="text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded px-2 py-1">Generate Example</button>
                  <button id="formatJson" class="text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded px-2 py-1">Format JSON</button>
                  <button id="clearBody" class="text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded px-2 py-1">Clear</button>
                </div>
              </div>
              <textarea id="bodyInput" class="mt-2 w-full h-64 bg-slate-800 border border-slate-700 rounded p-2 text-xs code" placeholder="{ }"></textarea>
            </div>
          </section>

          <!-- Response -->
          <section class="h-full overflow-auto">
            <div class="px-4 py-3">
              <div class="text-xs text-slate-300 mb-2">Response</div>
              <pre id="respOutput" class="bg-slate-800 border border-slate-700 rounded p-3 text-xs code whitespace-pre-wrap"></pre>
            </div>
          </section>
        </div>
      </main>
    </div>

    <script src="/js/api-postman.js"></script>
  </body>
  </html>
