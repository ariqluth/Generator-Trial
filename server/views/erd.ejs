<!DOCTYPE html>
<html>
  <head>
    <title>ERD Visualizer</title>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
      window.mermaid = mermaid;
    </script>
    <link
      href="https://unpkg.com/handsontable/dist/handsontable.full.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body {
        font-family: "Inter", Arial, sans-serif;
        background: #f6f7fb;
        margin: 0;
      }
      h2 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 1.5em 0 1em 0;
        letter-spacing: 0.01em;
      }
      #sidebar {
        min-width: 220px;
        max-width: 320px;
        background: #f8fafc;
        box-shadow: 0 1px 4px #0001;
        padding: 1.2em 0.8em;
        font-size: 0.98rem;
        height: 100vh;
        position: sticky;
        top: 0;
        border: 1px solid #e5e7eb;
        overflow-y: auto;
      }
      #sidebar .title {
        font-weight: 600;
        margin-bottom: 0.7em;
        font-size: 1em;
        color: #334155;
        letter-spacing: 0.01em;
      }
      #model-list {
        display: flex;
        flex-direction: column;
        gap: 0.3em;
      }
      #model-list label {
        cursor: pointer;
        user-select: none;
        font-size: 0.97em;
        color: #334155;
        padding: 0.1em 0.2em;
        border-radius: 4px;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5em;
      }
      #model-list label:hover {
        background: #f1f5f9;
      }
      #model-list input[type="checkbox"] {
        accent-color: #6366f1;
        width: 1rem;
        height: 1rem;
        min-width: 1rem;
        min-height: 1rem;
        box-sizing: border-box;
        margin-right: 0.5em;
        vertical-align: middle;
      }
      #mermaid {
        overflow-x: auto;
        min-height: 100vh;
        background: #fff;
        border: 1px solid #e5e7eb;
        padding: 1em;
        border-radius: 4px;
        margin-top: 0.5em;
      }
      @media (max-width: 900px) {
        #sidebar {
          display: none;
        }
        main {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <div
        id="sidebar"
        class="w-70 bg-slate-50 border-r border-slate-200 transition-all duration-300 flex flex-col h-full overflow-y-auto"
        style="min-width: 220px; max-width: 320px"
      >
        <div class="p-1 flex flex-col h-full">
          <div class="mb-4 flex items-center justify-between">
            <h2
              class="text-xs font-medium text-slate-600 uppercase tracking-wider px-2"
            >
              ERD Models <sup>v.1.0</sup>
            </h2>
          </div>
          <div class="mb-2 px-2 flex items-center gap-2">
            <input
              id="searchTableInput"
              type="text"
              placeholder="Search model..."
              class="w-full px-2 py-1.5 rounded border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-400 bg-white"
            />
            <button
              id="selectAllBtn"
              type="button"
              class="text-xs px-2 py-1 rounded bg-indigo-500 text-white hover:bg-indigo-600 transition flex items-center justify-center"
              title="Select/Unselect All Models"
              style="min-width: 30px; min-height: 30px"
            >
              <i id="selectAllIcon" class="fa-solid fa-check-double"></i>
            </button>
          </div>
          <div id="tablesCount" class="text-xs text-slate-500 px-2 mb-1"></div>
          <div class="flex-1 overflow-y-auto px-2 min-h-0">
            <div id="model-list" class="space-y-0.5"></div>
          </div>
          <!-- Watermark developer -->
          <div
            class="px-2 pt-2 text-[11px] text-slate-400 text-center select-none"
          >
            <span class="inline-flex items-center gap-1.5 justify-center">
              <span>Developer by</span>
              <a
                href="https://instagram.com/amin.nur.azziz"
                target="_blank"
                class="inline-flex items-center gap-1.5 group"
              >
                <span
                  class="inline-flex items-center justify-center rounded-full bg-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 p-[2px]"
                >
                  <span
                    class="bg-white rounded-full p-[2px] flex items-center justify-center"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <rect
                        x="3"
                        y="3"
                        width="18"
                        height="18"
                        rx="5"
                        fill="white"
                      />
                      <rect
                        x="3"
                        y="3"
                        width="18"
                        height="18"
                        rx="5"
                        stroke="#e1306c"
                        stroke-width="1.2"
                      />
                      <circle
                        cx="12"
                        cy="12"
                        r="4"
                        stroke="#e1306c"
                        stroke-width="1.2"
                        fill="none"
                      />
                      <circle cx="16.5" cy="7.5" r="1" fill="#e1306c" />
                    </svg>
                  </span>
                </span>
                <span
                  class="text-blue-500 font-semibold group-hover:underline transition"
                  >AzzizDev</span
                >
              </a>
            </span>
          </div>
        </div>
      </div>
      <!-- Main Content -->
      <div class="flex-1 overflow-y-auto bg-slate-100/50">
        <div class="px-4 py-4">
          <h2 class="text-lg font-semibold mb-4">
            Entity Relationship Diagram (ERD)
          </h2>
          <div id="mermaid"></div>
        </div>
      </div>
    </div>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
      let allData = null;
      let checkedModels = new Set();

      async function fetchData() {
        const res = await fetch("/api/erd/structures");
        const data = await res.json();
        if (!data.success) {
          document.getElementById("mermaid").innerText = "Failed to load data";
          return;
        }
        allData = data;
        renderModelList();
        renderERD();
      }

      function renderModelList() {
        const modelListDiv = document.getElementById("model-list");
        modelListDiv.innerHTML = "";
        const searchInput = document.getElementById("searchTableInput");
        let models = Object.keys(allData.models).filter(
          (m) => !m.startsWith("//")
        );
        // Search filter
        if (searchInput && searchInput.value) {
          const q = searchInput.value.toLowerCase();
          models = models.filter((m) => m.toLowerCase().includes(q));
        }
        document.getElementById("tablesCount").innerText =
          models.length + " models";
        models.forEach((model) => {
          const id = `model-cb-${model}`;
          const row = document.createElement("div");
          row.className =
            "flex items-center gap-2 px-2 py-1 rounded hover:bg-slate-100 transition select-none";
          // Checkbox
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.id = id;
          cb.value = model;
          cb.checked = checkedModels.has(model);
          cb.className = "w-4 h-4 text-indigo-600 align-middle";
          cb.style.margin = "0";
          cb.addEventListener("change", () => {
            if (cb.checked) checkedModels.add(model);
            else checkedModels.delete(model);
            renderERD();
          });
          // Label
          const label = document.createElement("label");
          label.htmlFor = id;
          label.innerHTML = `<i class='fa-solid fa-table mr-1 text-slate-400'></i> <span class='align-middle'>${model}</span>`;
          label.className =
            "cursor-pointer user-select-none text-xs align-middle";
          row.appendChild(cb);
          row.appendChild(label);
          modelListDiv.appendChild(row);
        });
      }
      // Search event
      document.addEventListener("DOMContentLoaded", () => {
        const searchInput = document.getElementById("searchTableInput");
        if (searchInput) {
          searchInput.addEventListener("input", renderModelList);
        }
        // Add select all button event
        const selectAllBtn = document.getElementById("selectAllBtn");
        const selectAllIcon = document.getElementById("selectAllIcon");
        if (selectAllBtn) {
          selectAllBtn.addEventListener("click", () => {
            if (!allData) return;
            let models = Object.keys(allData.models).filter(
              (m) => !m.startsWith("//")
            );
            const allSelected = models.every((model) =>
              checkedModels.has(model)
            );
            if (allSelected) {
              checkedModels.clear();
            } else {
              models.forEach((model) => checkedModels.add(model));
            }
            renderModelList();
            renderERD();
          });
        }
      });

      async function renderERD() {
        if (!allData) return;
        let mermaidStr = "erDiagram\n";
        // Only render checked models
        for (const [model, fields] of Object.entries(allData.models)) {
          if (model.startsWith("//") || !checkedModels.has(model)) continue;
          mermaidStr += `  ${model} {\n`;
          for (const field of fields) {
            if (typeof field !== "object" && typeof field !== "string")
              continue;
            let fieldName, fieldType;
            if (typeof field === "string") {
              fieldName = field;
              fieldType = "string";
            } else if (Array.isArray(field)) {
              fieldName = field[0];
              fieldType = field[1] || "string";
            } else if (field && typeof field === "object") {
              fieldName =
                field.name || field.fieldName || Object.keys(field)[0];
              fieldType = field.type || field.dataType || "string";
            }
            if (!fieldName || fieldName.startsWith("//")) continue;
            mermaidStr += `    ${fieldType} ${fieldName}\n`;
          }
          mermaidStr += "  }\n";
        }
        // Only show each relation once
        const drawnRelations = new Set();
        for (const [src, rels] of Object.entries(allData.associations)) {
          if (src.startsWith("//") || !checkedModels.has(src)) continue;
          for (const [field, rel] of Object.entries(rels)) {
            if (typeof field !== "string" || field.startsWith("//")) continue;
            if (!checkedModels.has(rel.model)) continue;
            // Create a unique key for the relation (sorted to avoid duplicates)
            const relKey = [src, rel.model].sort().join("--") + ":" + field;
            if (drawnRelations.has(relKey)) continue;
            drawnRelations.add(relKey);
            let relType =
              rel.type === "belongsTo"
                ? "||--o{"
                : rel.type === "hasMany"
                ? "}o--||"
                : "||--||";
            mermaidStr += `  ${src} ${relType} ${rel.model} : ${field}\n`;
          }
        }
        document.getElementById("mermaid").innerText = mermaidStr;
        const { svg } = await mermaid.render("erdDiagram", mermaidStr);
        document.getElementById("mermaid").innerHTML = svg;
      }
      fetchData();
    </script>
  </body>
</html>
